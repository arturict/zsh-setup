#!/usr/bin/env bash
set -Eeuo pipefail

APP_DIR="${XDG_DATA_HOME:-$HOME/.local/share}/devhub"
CORE="${DEVHUB_CORE:-$HOME/.local/bin/devhub-core}"

case "${1:-dashboard}" in
  dashboard)
    command -v bun >/dev/null 2>&1 || { printf 'devhub requires Bun. Run the setup again and select Bun.\n' >&2; exit 1; }
    exec bun "$APP_DIR/index.ts"
    ;;
  *) exec "$CORE" "$@" ;;
esac
