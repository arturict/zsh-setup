#!/usr/bin/env bash
set -Eeuo pipefail

VERSION="1.0.0"
CONFIG_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/artur-zsh-setup"
STATE_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/devhub"
TIPS_FILE="$CONFIG_DIR/content/tips.tsv"
LESSONS_FILE="$CONFIG_DIR/content/lessons.tsv"
REPO_URL="https://github.com/arturict/zsh-setup.git"
mkdir -p "$STATE_DIR"

if [[ -t 1 && -z ${NO_COLOR:-} ]]; then
  BLUE=$'\033[38;5;75m'; PURPLE=$'\033[38;5;141m'; GREEN=$'\033[38;5;114m'
  YELLOW=$'\033[38;5;221m'; RED=$'\033[38;5;203m'; DIM=$'\033[2m'; BOLD=$'\033[1m'; RESET=$'\033[0m'
else
  BLUE="" PURPLE="" GREEN="" YELLOW="" RED="" DIM="" BOLD="" RESET=""
fi

platform() {
  if [[ ${OS:-} == Windows_NT ]]; then printf 'windows';
  elif grep -qi microsoft /proc/version 2>/dev/null; then printf 'wsl';
  else printf 'ubuntu'; fi
}

has() { command -v "$1" >/dev/null 2>&1; }
pause() { [[ -t 0 ]] && read -r -p $'\nEnter zum Fortfahren …' _ || true; }
clear_screen() { if [[ -t 1 ]]; then printf '\033[2J\033[H'; fi; }

header() {
  clear_screen
  printf '%s%s devhub %s%s  %s%s%s\n' "$BOLD" "$BLUE" "$VERSION" "$RESET" "$DIM" "$(hostname) · $(platform) · ${PWD/#$HOME/~}" "$RESET"
  printf '%s\n\n' '────────────────────────────────────────────────────────────────────'
}

random_tip() {
  [[ -r "$TIPS_FILE" ]] || return 0
  awk -F '\t' 'BEGIN{srand()} {a[NR]=$0} END{if(NR) print a[1+int(rand()*NR)]}' "$TIPS_FILE"
}

tip_card() {
  local row category command description
  row="$(random_tip)"; [[ -n "$row" ]] || return 0
  IFS=$'\t' read -r category command description <<<"$row"
  printf '%sTipp · %s%s\n' "$PURPLE" "$category" "$RESET"
  printf '  %s%s%s\n' "$BOLD" "$command" "$RESET"
  printf '  %s\n' "$description"
}

status_line() {
  local label="$1" command="$2"
  if has "$command"; then printf '  %s●%s %-12s %s\n' "$GREEN" "$RESET" "$label" "$(command -v "$command")"
  else printf '  %s○%s %-12s nicht installiert\n' "$RED" "$RESET" "$label"; fi
}

doctor() {
  header
  printf '%sSystemcheck%s\n\n' "$BOLD" "$RESET"
  status_line Git git; status_line GitHub gh; status_line tmux tmux; status_line fzf fzf
  status_line ripgrep rg; status_line Bun bun; status_line Node node; status_line uv uv
  status_line Codex codex; status_line Claude claude; status_line OpenCode opencode
  printf '\n%sAuthentifizierung%s\n' "$BOLD" "$RESET"
  if has gh && gh auth status >/dev/null 2>&1; then printf '  %s●%s GitHub CLI angemeldet\n' "$GREEN" "$RESET"; else printf '  %s○%s GitHub: gh auth login\n' "$YELLOW" "$RESET"; fi
  if has codex && codex login status >/dev/null 2>&1; then printf '  %s●%s Codex angemeldet\n' "$GREEN" "$RESET"; else printf '  %s○%s Codex: codex login\n' "$YELLOW" "$RESET"; fi
  if has opencode && opencode auth list 2>&1 | grep -qi 'credential'; then printf '  %s●%s OpenCode Credentials vorhanden\n' "$GREEN" "$RESET"; else printf '  %s○%s OpenCode: opencode auth login\n' "$YELLOW" "$RESET"; fi
  [[ -f "$HOME/.tmux.conf" ]] && printf '  %s●%s tmux-Konfiguration vorhanden\n' "$GREEN" "$RESET" || printf '  %s○%s tmux-Konfiguration fehlt\n' "$RED" "$RESET"
}

auth_help() {
  header
  printf '%sAuth-Zentrale%s\n\n' "$BOLD" "$RESET"
  printf '  GitHub    %sgh auth login%s\n' "$BLUE" "$RESET"
  printf '  Codex     %scodex login%s\n' "$BLUE" "$RESET"
  printf '  OpenCode  %sopencode auth login%s\n' "$BLUE" "$RESET"
  printf '  Claude    %sclaude /login%s\n\n' "$BLUE" "$RESET"
  printf '%sTokens werden nie im Repository gespeichert.%s\n' "$YELLOW" "$RESET"
  printf 'Mit %sdevhub doctor%s prüfst du danach den Status.\n' "$BOLD" "$RESET"
}

tmux_help() {
  header
  printf '%stmux · dein persistenter Workspace%s\n\n' "$BOLD" "$RESET"
  printf '  %-18s %s\n' 't' 'Projekt-Session öffnen oder erstellen'
  printf '  %-18s %s\n' 'Ctrl-a s' 'Sessions/Fenster auswählen'
  printf '  %-18s %s\n' 'Ctrl-a c' 'Neues Fenster im aktuellen Verzeichnis'
  printf '  %-18s %s\n' 'Ctrl-a | / -' 'Pane rechts beziehungsweise unten öffnen'
  printf '  %-18s %s\n' 'Ctrl-a h/j/k/l' 'Zwischen Panes wechseln'
  printf '  %-18s %s\n' 'Ctrl-a d' 'Trennen; Prozesse laufen weiter'
  printf '\nBei interaktiven SSH-Logins wird %smain%s automatisch fortgesetzt.\n' "$BOLD" "$RESET"
}

list_tips() {
  header
  printf '%sCommand-Bibliothek%s\n\n' "$BOLD" "$RESET"
  if [[ ! -r "$TIPS_FILE" ]]; then printf 'Keine Lerninhalte installiert.\n'; return; fi
  awk -F '\t' '{printf "%-10s  %-28s %s\n", "["$1"]", $2, $3}' "$TIPS_FILE"
}

learn() {
  header
  printf '%sGeführte Kurzlektionen%s\n\n' "$BOLD" "$RESET"
  [[ -r "$LESSONS_FILE" ]] || { printf 'Keine Lektionen installiert.\n'; return; }
  local i=0 id title commands description
  while IFS=$'\t' read -r id title commands description; do
    i=$((i+1)); printf '  %s%d)%s %s\n' "$BLUE" "$i" "$RESET" "$title"
  done < "$LESSONS_FILE"
  printf '\nAuswahl [1-%d, q]: ' "$i"
  read -r choice
  [[ "$choice" =~ ^[0-9]+$ ]] || return 0
  local row; row="$(sed -n "${choice}p" "$LESSONS_FILE")"; [[ -n "$row" ]] || return 0
  IFS=$'\t' read -r id title commands description <<<"$row"
  header; printf '%s%s%s\n\n%s\n\n' "$BOLD" "$title" "$RESET" "$description"
  tr ';' '\n' <<<"$commands" | sed 's/^/  → /'
  printf '%s\n' "$id" >> "$STATE_DIR/completed-lessons"
}

sessions() {
  if ! has tmux; then printf 'tmux ist nicht installiert. Nutze devhub update.\n'; return 1; fi
  if [[ -n ${TMUX:-} ]]; then tmux choose-tree -Zw; else tmux new-session -A -s "$(basename "$PWD" | tr -cs 'A-Za-z0-9_.-' '-')" -c "$PWD"; fi
}

update_setup() {
  local tmp; tmp="$(mktemp -d)"; trap 'rm -rf "$tmp"' RETURN
  git clone --depth=1 "$REPO_URL" "$tmp/zsh-setup"
  exec bash "$tmp/zsh-setup/setup.sh" --yes
}

dashboard() {
  while true; do
    header
    printf '%sDein Development Workspace%s\n\n' "$BOLD" "$RESET"
    tip_card
    printf '\n%sAktionen%s\n' "$BOLD" "$RESET"
    printf '  %s1%s  Projekt-Workspace öffnen       %s5%s  Auth-Zentrale\n' "$BLUE" "$RESET" "$BLUE" "$RESET"
    printf '  %s2%s  tmux lernen                    %s6%s  System prüfen\n' "$BLUE" "$RESET" "$BLUE" "$RESET"
    printf '  %s3%s  Kurzlektion                    %s7%s  Setup aktualisieren\n' "$BLUE" "$RESET" "$BLUE" "$RESET"
    printf '  %s4%s  Command-Bibliothek             %sq%s  Beenden\n' "$BLUE" "$RESET" "$BLUE" "$RESET"
    printf '\nAuswahl: '; read -r choice
    case "$choice" in
      1) sessions ;;
      2) tmux_help; pause ;;
      3) learn; pause ;;
      4) list_tips; pause ;;
      5) auth_help; pause ;;
      6) doctor; pause ;;
      7) update_setup ;;
      q|Q) clear_screen; return ;;
    esac
  done
}

usage() {
  cat <<'EOF'
devhub [command]

  devhub             Geführtes Fullscreen-Dashboard
  devhub doctor      Installation und Auth prüfen
  devhub tmux        tmux-Cheatsheet
  devhub sessions    Projekt-Session öffnen
  devhub learn       Interaktive Kurzlektionen
  devhub tips        Command-Bibliothek
  devhub auth        Sichere Login-Anleitung
  devhub update      Setup aktualisieren
EOF
}

case "${1:-dashboard}" in
  dashboard) dashboard ;;
  doctor) doctor ;;
  tmux) tmux_help ;;
  sessions) sessions ;;
  learn) learn ;;
  tips) list_tips ;;
  auth) auth_help ;;
  update) update_setup ;;
  help|-h|--help) usage ;;
  version|-v|--version) printf 'devhub %s\n' "$VERSION" ;;
  *) printf 'Unbekannter Befehl: %s\n\n' "$1" >&2; usage >&2; exit 2 ;;
esac
